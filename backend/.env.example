# 应用配置
APP_NAME=AI创作者平台
APP_VERSION=1.0.0
DEBUG=True

# 数据库配置
DATABASE_URL=mysql+pymysql://ai_creator:ai_creator123@localhost:3306/ai_creator

# Redis配置
REDIS_URL=redis://localhost:6379/0

# JWT配置
# ⚠️ 生产环境（DEBUG=False）必改：检测到默认值将拒绝启动（T3）
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
# 管理端令牌（T1）：建议独立设置更长随机密钥；管理令牌有效期默认30分钟
ADMIN_SECRET_KEY=
ADMIN_TOKEN_EXPIRE_MINUTES=30
# 管理接口 IP 白名单（T2）：填写 VPN/办公网段，如 ["10.0.0.0/8"]；留空表示不限制
ADMIN_IP_WHITELIST=[]

# CORS配置
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI服务配置（示例，实际使用时需要配置真实的API密钥）
# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# 智谱AI
ZHIPU_API_KEY=your-zhipu-api-key

# 百度文心
BAIDU_API_KEY=your-baidu-api-key
BAIDU_SECRET_KEY=your-baidu-secret-key

# 文件上传配置
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# 支付回调签名密钥（网关回调 HMAC 校验用，生产环境务必更换）
PAYMENT_CALLBACK_SECRET=change-me-payment-callback-secret

# 管理员初始密码（T3）：initdb 创建管理员时使用；留空则生成随机密码仅打印一次
ADMIN_INIT_PASSWORD=

# OAuth 凭据加密密钥（生产环境务必更换为强随机值）
OAUTH_ENCRYPTION_KEY=your-oauth-encryption-key-change-in-production

# API 文档开关（T4）：留空=跟随 DEBUG（开发开、生产关）；生产需要时显式设为 true 并配合 IP 白名单
ENABLE_API_DOCS=
